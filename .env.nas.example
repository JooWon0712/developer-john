# Copy to .env beside compose.nas.yaml on the NAS.
# These are examples; confirm the project name, imported image tag and free port.
COMPOSE_PROJECT_NAME=johnwest-lab
JOHNWEST_IMAGE=johnwest-lab:local
JOHNWEST_BIND_ADDRESS=127.0.0.1
JOHNWEST_PORT=3310

# NEXT_PUBLIC_SITE_URL is a Docker build argument, not a runtime setting here.
# Choose a free host port without changing other applications.
