# Build-time public origin, matching the selected domain and the app default.
NEXT_PUBLIC_SITE_URL=https://developer-john.com

# Copy this file to .env.local if needed.
# For local-origin metadata, replace the value above with:
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Domain purchase is confirmed by the owner; DNS/HTTPS connection is pending.
# NEXT_PUBLIC_* values are public. Never put credentials in these variables.
# Changing the origin after a production build requires rebuilding the app/image.
